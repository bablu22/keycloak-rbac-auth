{
  "realm": "erp-realm",
  "enabled": true,
  "displayName": "ERP Realm",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "rememberMe": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "sslRequired": "external",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@erp.local",
    "fromDisplayName": "LedgerOS",
    "replyTo": "noreply@erp.local",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "roles": {
    "realm": [
      {
        "name": "super_admin",
        "description": "Full system access"
      },
      {
        "name": "admin",
        "description": "ERP administrator"
      },
      {
        "name": "manager",
        "description": "Department manager"
      },
      {
        "name": "accountant",
        "description": "Finance / accounting"
      },
      {
        "name": "hr",
        "description": "Human resources"
      },
      {
        "name": "sales",
        "description": "Sales team"
      },
      {
        "name": "warehouse",
        "description": "Inventory / warehouse"
      },
      {
        "name": "employee",
        "description": "Base employee access"
      }
    ],
    "client": {
      "nest-api": [
        { "name": "invoice_read", "description": "View invoices" },
        { "name": "invoice_create", "description": "Create invoices" },
        { "name": "invoice_approve", "description": "Approve invoices" },
        { "name": "invoice_delete", "description": "Delete invoices" },
        { "name": "payroll_view", "description": "View payroll" },
        { "name": "payroll_run", "description": "Run payroll" },
        { "name": "inventory_view", "description": "View inventory" },
        { "name": "inventory_adjust", "description": "Adjust stock" },
        { "name": "user_read", "description": "View users" },
        { "name": "user_manage", "description": "Manage users" },
        { "name": "report_finance", "description": "Finance reports" },
        { "name": "report_sales", "description": "Sales reports" }
      ]
    }
  },
  "groups": [
    {
      "name": "Finance",
      "path": "/Finance",
      "realmRoles": ["accountant", "employee"],
      "clientRoles": {
        "nest-api": [
          "invoice_read",
          "invoice_create",
          "report_finance"
        ]
      }
    },
    {
      "name": "Sales",
      "path": "/Sales",
      "realmRoles": ["sales", "employee"],
      "clientRoles": {
        "nest-api": ["invoice_read", "report_sales"]
      }
    },
    {
      "name": "HR",
      "path": "/HR",
      "realmRoles": ["hr", "employee"],
      "clientRoles": {
        "nest-api": ["user_read", "user_manage", "payroll_view"]
      }
    },
    {
      "name": "Warehouse",
      "path": "/Warehouse",
      "realmRoles": ["warehouse", "employee"],
      "clientRoles": {
        "nest-api": ["inventory_view", "inventory_adjust"]
      }
    },
    {
      "name": "Management",
      "path": "/Management",
      "realmRoles": ["manager", "employee"],
      "clientRoles": {
        "nest-api": [
          "invoice_read",
          "invoice_approve",
          "payroll_view",
          "inventory_view",
          "user_read",
          "report_finance",
          "report_sales"
        ]
      }
    },
    {
      "name": "Admins",
      "path": "/Admins",
      "realmRoles": ["admin", "employee"],
      "clientRoles": {
        "nest-api": [
          "invoice_read",
          "invoice_create",
          "invoice_approve",
          "invoice_delete",
          "payroll_view",
          "payroll_run",
          "inventory_view",
          "inventory_adjust",
          "user_read",
          "user_manage",
          "report_finance",
          "report_sales"
        ]
      }
    }
  ],
  "users": [
    {
